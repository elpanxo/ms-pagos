# Azure AD issuer URI used by the existing microservices
AZURE_TENANT_ID=TENANT_ID
AZURE_CLIENT_ID=API_CLIENT_ID

# Public endpoints. Webpay must be able to reach TRANSBANK_RETURN_URL over HTTPS.
ORDENES_SERVICE_URL=http://host.docker.internal:8084/api/v1/ordenes
FRONTEND_URL=http://localhost:5173
TRANSBANK_RETURN_URL=https://your-public-host/api/pagos/retorno

# Integration values are defaults for development. Production must use Transbank credentials.
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=integration

# Comma-separated allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
